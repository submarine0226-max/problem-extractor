# .env 로 복사해서 쓰세요. .env 는 git에 올라가지 않습니다.

# 추출에 쓸 모델 제공사: gemini(무료 등급 있음) | claude(유료)
PX_PROVIDER=gemini

# gemini: https://aistudio.google.com/apikey 에서 무료 발급 (카드 등록 필요 없음)
GEMINI_API_KEY=

# claude: https://console.anthropic.com 에서 발급 (유료)
ANTHROPIC_API_KEY=

# 모델 이름. 비우면 제공사별 기본값 (gemini-3.5-flash-lite / claude-opus-5-5)
# 수식이 복잡해 정확도가 아쉬우면 gemini-3.8-flash 를 써 보세요 (무료 하루 한도는 더 적을 수 있어요)
PX_MODEL=

# claude 전용: 사고 깊이 (low | medium | high | xhigh | max)
PX_EFFORT=medium

# DB(problems.db)와 이미지가 저장될 폴더
PX_DATA_DIR=data

# 모델에 보낼 이미지의 긴 변 최대 픽셀 (그림 크롭은 원본 해상도로 함)
PX_MAX_IMAGE_SIDE=2000

# 업로드 최대 크기(MB)
PX_MAX_UPLOAD_MB=15

# 웹 화면을 Vercel 등 다른 주소에 올렸을 때, 그 주소를 적어야 이 서버를 부를 수 있어요.
# 여러 개면 쉼표로. 예: PX_CORS_ORIGINS=https://my-problems.vercel.app
# 비워 두면 http://localhost:8000 에서 서버가 직접 띄우는 화면만 쓸 수 있어요.
PX_CORS_ORIGINS=
